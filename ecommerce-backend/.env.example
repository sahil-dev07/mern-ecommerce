# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# MongoDB connection string. Rotate the Atlas password before use; never commit the real value.
DATABASE_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Ecommerce?retryWrites=true&w=majority

# Secret used to sign JWTs (Phase B). Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me
JWT_EXPIRES_IN=7d

# HTTP port (Render injects this automatically in production).
PORT=8080

# Comma-separated allowlist of frontend origins (used by CORS in Phase C).
FRONTEND_ORIGIN=http://localhost:5173

# Log verbosity: debug in dev, info in prod.
LOG_LEVEL=debug

# First-admin seed (Phase G) — used ONLY by scripts/seed-admin.js to create/promote
# the initial admin, since signup can no longer set a role. Set these, run
# `node scripts/seed-admin.js` once, then unset them again.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me-strong
ADMIN_NAME=Admin
